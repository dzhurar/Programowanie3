<Window x:Class="Programowanie3.Calc"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Calc" Height="1000" Width="600">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--7/4-->
        <TextBox BorderBrush="Black" BorderThickness="2" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">Input some values</TextBox>
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4">Result will be here</TextBlock>
        <Button Grid.Row="2" Grid.Column="0" Content="C" Margin="10"/>
        <Button Grid.Row="2" Grid.Column="1" Content="Backspace" Margin="10"/>
        <Button Grid.Row="2" Grid.Column="2" Content="%" Margin="10"/>
        <Button Grid.Row="2" Grid.Column="3" Content="÷" Margin="10" Click="Button_Click"/>

        <Button Grid.Row="3" Grid.Column="0" Content="7" Margin="10"/>
        <Button Grid.Row="3" Grid.Column="1" Content="8" Margin="10"/>
        <Button Grid.Row="3" Grid.Column="2" Content="9" Margin="10"/>
        <Button Grid.Row="3" Grid.Column="3" Content="x" Margin="10"/>

        <Button Grid.Row="4" Grid.Column="0" Content="4" Margin="10"/>
        <Button Grid.Row="4" Grid.Column="1" Content="5" Margin="10"/>
        <Button Grid.Row="4" Grid.Column="2" Content="6" Margin="10"/>
        <Button Grid.Row="4" Grid.Column="3" Content="-" Margin="10"/>

        <Button Grid.Row="5" Grid.Column="0" Content="1" Margin="10"/>
        <Button Grid.Row="5" Grid.Column="1" Content="2" Margin="10"/>
        <Button Grid.Row="5" Grid.Column="2" Content="3" Margin="10"/>
        <Button Grid.Row="5" Grid.Column="3" Content="+" Margin="10"/>

        <Button Grid.Row="6" Grid.Column="0" Content="0"  Grid.ColumnSpan="2" Margin="10"/>
        <Button Grid.Row="6" Grid.Column="2" Content="." Margin="10"/>
        <Button Grid.Row="6" Grid.Column="3" Content="=" Margin="10"/>
    </Grid>
</Window>
