<Window x:Class="Programowanie3.Task2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Task2" Height="450" Width="800">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Imię" FontSize="20" Margin="10"/>
            <TextBox FontSize="20" Margin="10" TextChanged="TextBox_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Nazwisko" FontSize="20" Margin="10"/>
            <TextBox FontSize="20" Margin="10" TextChanged="TextBox_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Data urodzenia" FontSize="20" Margin="10"/>
            <DatePicker FontSize="20" Margin="10"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Semestr" FontSize="20" Margin="10"/>
            <TextBox FontSize="20" Margin="10"/>
        </StackPanel>
        <Button Content="Zapisz" FontSize="20" Margin="10"/>
    </StackPanel>
</Window>
