<Window x:Class="Programowanie3.Task3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Task3" Height="200" Width="200">
    <DockPanel>
        <TextBlock Background="LightGray" TextAlignment="Center" DockPanel.Dock="Bottom" Width="auto" Text="Bottom"/>
        <TextBlock Background="LightGray" TextAlignment="Center" DockPanel.Dock="Left" Width="auto" Text="Left"/>
        <TextBlock Background="LightGray" TextAlignment="Center" DockPanel.Dock="Right" Width="auto" Text="Right"/>
        <TextBlock Background="Red" TextAlignment="Center" DockPanel.Dock="Top" Width="auto" Text="Top"/>
        <TextBlock Background="Green" TextAlignment="Center" DockPanel.Dock="Top" Width="50" Height="50" Text="Top2"/>
        <TextBlock Background="LightGray" TextAlignment="Center" DockPanel.Dock="Right" Width="auto" Height="50" Text="Right2"/>
        <TextBlock Background="LightGray" TextAlignment="Center" DockPanel.Dock="Right" Width="auto" Height="50" Text="Right3"/>
        <TextBlock Background="Blue" TextAlignment="Center" DockPanel.Dock="Top" Width="auto" Height="50" Text="Top3"/>
        <TextBlock Background="LightGray" TextAlignment="Center" Text="Fill"/>
    </DockPanel>
</Window>
