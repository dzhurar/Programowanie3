<Window x:Class="Programowanie3.Battleship"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programowanie3"
        mc:Ignorable="d"
        Title="Battleship" Height="500" Width="900">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--player 1 grid-->
        <ItemsControl Grid.Column="0" ItemsSource="{Binding MyBoard}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="10" Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding}" Margin="1" IsHitTestVisible="False">
                        <Button.Style>
                            <Style TargetType="Button"> 
                                <Setter Property="Background" Value="LightBlue"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Ship">
                                        <Setter Property="Background" Value="DimGray"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Hit">
                                        <Setter Property="Background" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Miss">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                  
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--enemy grid-->
        <ItemsControl Grid.Column="2" ItemsSource="{Binding EnemyBoard}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="10" Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding}" Margin="1" Click="EnemyCell_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="LightBlue"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Hit">
                                        <Setter Property="Background" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Miss">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
